# Publish a portable ECM showcase. The complete working research archive remains
# on disk at its original paths and is intentionally kept outside this Git tree.
/*
!/.gitignore
!/README.md
!/NOTICE.md
!/requirements-ecm.txt
!/.github/
!/.github/workflows/
!/.github/workflows/ecm.yml
!/config/
/config/*
!/config/ecm.json
!/data/
/data/*
!/data/quarterly_panel.csv
!/data/gdp_accounting.csv
!/data/bootstrap_parameters.csv
!/data/sources.json
!/data/wealth_effects_inputs.xlsx
!/docs/
/docs/*
!/docs/ECM_METHODOLOGY.md
!/docs/DATA_SOURCES.md
!/docs/REPRODUCIBILITY.md
!/docs/LOCAL_ARCHIVE.md
!/scripts/
/scripts/*
!/scripts/run_ecm.py
!/wealth_effects/
/wealth_effects/*
!/wealth_effects/__init__.py
!/wealth_effects/note454_ecm.py
!/wealth_effects/note454_ratio.py
!/wealth_effects/note454_ratio_ecm.py
!/wealth_effects/note454_gdp_draws.py
!/wealth_effects/ecm_gdp.py
!/wealth_effects/ecm_publication.py
!/tests/
/tests/*
!/tests/test_note454_ecm.py
!/tests/test_note454_ratio.py
!/tests/test_note454_ratio_ecm.py
!/tests/test_public_ecm.py
!/results/
/results/*
!/results/RESULTS.md
!/results/coefficients.csv
!/results/quarterly_gdp_growth.csv
!/results/channel_gdp_growth.csv
!/results/quarterly_consumption_contributions.csv
!/results/annual_consumption_contributions.csv
!/results/period_summary.csv
!/results/diagnostics.json
!/results/run_manifest.json
!/results/quarterly_gdp_wealth.png
!/results/quarterly_gdp_wealth.pdf
!/results/annual_gdp_wealth.png
!/results/annual_gdp_wealth.pdf
!/results/consumption_decomposition.png
!/results/consumption_decomposition.pdf

# Never publish credentials, runtime caches, or generated full bootstrap paths.
**/__pycache__/
*.py[cod]
.venv/
.mplconfig/
.DS_Store
.env
.env.*
*.key
*.pem

# Frozen-coefficient AI/S&P extension, kept separate from baseline outputs.
!/config/ai_split.json
!/data/spx_ai_split_sources.json
!/docs/AI_ECM_SPLIT.md
!/scripts/run_ai_ecm_split.py
!/wealth_effects/ecm_ai_split.py
!/wealth_effects/ecm_ai_publication.py
!/tests/test_ecm_ai_split.py
!/results/ai_split/
/results/ai_split/*
!/results/ai_split/RESULTS.md
!/results/ai_split/quarterly_wealth_split.csv
!/results/ai_split/quarterly_all_channels.csv
!/results/ai_split/period_summary.csv
!/results/ai_split/diagnostics.json
!/results/ai_split/run_manifest.json
!/results/ai_split/wealth_split.png
!/results/ai_split/wealth_split.pdf
!/results/ai_split/ai_other_intervals.png
!/results/ai_split/ai_other_intervals.pdf
!/results/ai_split/mapping_sensitivity.png
!/results/ai_split/mapping_sensitivity.pdf

# Keep the user-supplied AI/non-AI source series and detailed gain ledger local.
/data/spx_ai_split_inputs.csv
/results/ai_split/capitalization_ownership_ledger.csv

# Public charts made only from saved model outputs and public GDP data.
!/wealth_effects/ecm_column_charts.py
!/scripts/plot_ecm_columns.py
!/results/ai_split/columns/
/results/ai_split/columns/*
!/results/ai_split/columns/README.md
!/results/ai_split/columns/column_chart_data.csv
!/results/ai_split/columns/gdp_with_without_wealth.png
!/results/ai_split/columns/gdp_with_without_wealth.pdf
!/results/ai_split/columns/wealth_ai_non_ai_other.png
!/results/ai_split/columns/wealth_ai_non_ai_other.pdf
!/results/ai_split/columns/run_manifest.json

!/results/ai_split/columns/wealth_share_of_gdp_growth.png
!/results/ai_split/columns/wealth_share_of_gdp_growth.pdf
